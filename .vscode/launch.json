{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Repo Compliance",
      "type": "debugpy",
      "request": "launch",
      "module": "repo_compliance",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      // Disable return value display to work around a debugpy enum bug while stepping.
      // Revisit when debugpy fixes the bug.
      "showReturnValue": false
    }
  ]
}
